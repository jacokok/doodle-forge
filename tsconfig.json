{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/worker/**/*.ts",
    "tools/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
