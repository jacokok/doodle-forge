{
  "name": "@doodleforge/worker",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/lifecycle.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@doodleforge/database": "workspace:*",
    "@doodleforge/shared": "workspace:*",
    "better-sqlite3": "13.0.3"
  }
}
