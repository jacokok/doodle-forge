{
  "name": "@doodleforge/worker",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/lifecycle.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --external:sharp --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@doodleforge/ai": "workspace:*",
    "@doodleforge/contracts": "workspace:*",
    "@doodleforge/database": "workspace:*",
    "@doodleforge/workflow": "workspace:*",
    "sharp": "0.34.5",
    "zod": "4.6.7",
    "@doodleforge/shared": "workspace:*",
    "better-sqlite3": "13.0.3"
  }
}
