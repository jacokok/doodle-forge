# Paths resolve against the repository root, not the process working directory.
DOODLEFORGE_STORAGE_ROOT=storage
# Defaults to <resolved storage root>/db/doodleforge.sqlite
# DOODLEFORGE_DATABASE_PATH=storage/db/doodleforge.sqlite
HOST=127.0.0.1
PORT=5173
ORIGIN=http://127.0.0.1:5173
# adapter-node request envelope: 10 MiB image + 64 KiB multipart framing
BODY_SIZE_LIMIT=10551296
WORKER_PORT=5174
# GODOT_BIN=/usr/bin/godot
# GODOT_TEMPLATE_DIR=/absolute/path/to/export_templates/4.7.2.stable
